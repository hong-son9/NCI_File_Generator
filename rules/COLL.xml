<?xml version="1.0" encoding="UTF-8"?>
<rules infoCd="COLL">
    <field name="recordType" required="Y" maxLen="1" values="D"/>
    <field name="evtCd" required="Y" maxLen="1" codeRef="C04" errCode="E143" weights="1:75,3:15,2:8,7:2"/>
    <field name="instCd" required="Y" maxLen="7"/>
    <field name="branchCd" required="N" maxLen="20"/>
    <field name="branchNm" required="N" maxLen="200"/>
    <field name="custCd" required="Y" maxLen="30" errCodeMissing="E127" default="CUST{cust:06d}"/>
    <field name="ctrtNo" required="Y" maxLen="50" errCode="E183" default="CL{run}{seq:06d}"/>
    <field name="debtorCustCd" required="Y" maxLen="20" default="CUST{cust:06d}"/>
    <field name="debtorCtrtNo" required="Y" maxLen="50" errCode="E182" default="LN{run}{seq:06d}"/>
    <field name="collRightTypeCd" required="Y" maxLen="2" codeRef="C25" errCode="E197"/>
    <field name="collTypeCd" required="Y" maxLen="2" codeRef="C24" errCode="E198" weights="11:45,12:25,18:15,22:5,15:4,38:3,21:3"/>
    <field name="occrDt" required="Y" maxLen="8" format="yyyymmdd" notFuture="Y" errCode="E129"/>
    <field name="collAmt" required="Y" maxLen="18" genRange="50000000-3000000000"/>
    <field name="evalDt" required="N" maxLen="8" format="yyyymmdd" notFuture="Y" errCode="E310"/>
    <field name="evalAmt" required="N" maxLen="18" genRange="80000000-5000000000"/>
    <field name="chgClsDt" required="Y" maxLen="8" format="yyyymmdd" notFuture="Y" errCode="E309"/>
    <field name="consentFg" required="Y" maxLen="1" values="1,0" errCode="E191" weights="1:97,0:3"/>

    <rule type="valueMap" field="collRightTypeCd" when="collTypeCd" map="11:12;12:11,12;13-20:11;21:11;22-28,38:12,11;*:11,12,14,16" level="warn" desc="Loại quyền bảo đảm phù hợp loại tài sản (BĐS thế chấp, giấy tờ có giá cầm cố)"/>
    <rule type="dateOrder" a="evalDt" b="occrDt" gap="0-90" adjust="a" level="warn" desc="Thẩm định giá trước khi ký hợp đồng bảo đảm"/>
    <rule type="lte" small="collAmt" big="evalAmt" ratio="0.5-0.8" level="warn" desc="Số tiền được bảo đảm ≤ giá trị thẩm định"/>
    <rule type="dateOrder" a="occrDt" b="chgClsDt" gap="0-1500" errCode="E309"/>
</rules>
