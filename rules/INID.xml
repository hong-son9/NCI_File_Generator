<?xml version="1.0" encoding="UTF-8"?>
<rules infoCd="INID">
    <field name="recordType" required="Y" maxLen="1" values="D"/>
    <field name="evtCd" required="Y" maxLen="1" codeRef="C04" errCode="E143" weights="1:80,3:15,2:3,7:2"/>
    <field name="instCd" required="Y" maxLen="7"/>
    <field name="branchCd" required="N" maxLen="20"/>
    <field name="branchNm" required="N" maxLen="200"/>
    <field name="custCd" required="Y" maxLen="30" errCodeMissing="E127" default="CUST{cust:06d}"/>
    <field name="subjectType" required="Y" maxLen="1" codeRef="C01" values="1" errCode="E101"/>
    <field name="cccdNo" required="M" maxLen="12" length="12" errCode="E175" pattern="^\d{12}$"/>
    <field name="cmndNo" required="M" maxLen="12" length="9" errCode="E102" pattern="^\d{9}$"/>
    <field name="idCardType" required="M" maxLen="1" codeRef="C03" values="3-8" errCode="E102"/>
    <field name="idNumber" required="M" maxLen="20" errCode="E102" gen="idNumber"/>
    <field name="idIssueDt" required="N" maxLen="8" format="yyyymmdd" notFuture="Y" errCode="E319"/>
    <field name="taxCode" required="N" maxLen="15" gen="taxPerson" fillRate="0.6" pattern="^\d{10}(-\d{3})?$"/>
    <field name="membNm" required="Y" maxLen="250" errCode="E176" errCodeMissing="E177" gen="personName"/>
    <field name="custLstUpdtDt" required="Y" maxLen="8" format="yyyymmdd" notFuture="Y" errCode="E315"/>
    <field name="birthDt" required="N" maxLen="8" format="yyyymmdd" notFuture="Y" errCode="E320"/>
    <field name="gender" required="N" maxLen="1" codeRef="C02" errCode="E178"/>
    <field name="nationalityCd" required="N" maxLen="3" codeRef="C36" errCode="E179" weights="VNM:95,KOR:2,CHN:1,JPN:1,USA:1"/>
    <field name="mobileNo" required="N" maxLen="15" pattern="^0\d{9}$"/>
    <field name="email" required="N" maxLen="100" errCode="E180" pattern="^[^@\s]+@[^@\s]+\.[^@\s]+$"/>
    <field name="homeTelNo" required="N" maxLen="15" fillRate="0.4" pattern="^0\d{9,10}$"/>
    <field name="homeAdr" required="M" maxLen="500" fillRate="0.95"/>
    <field name="homeZipCd" required="N" maxLen="5" pattern="^\d{5}$"/>
    <field name="officeTaxCode" required="N" maxLen="15" gen="taxCorp" pattern="^\d{10}(-\d{3})?$"/>
    <field name="officeNm" required="N" maxLen="250" gen="companyName"/>
    <field name="officeTypeCd" required="N" maxLen="2" codeRef="C07" errCode="E302" gen="corpType"/>
    <field name="officeBusinessLineCd" required="N" maxLen="3" codeRef="C08" errCode="E301"/>
    <field name="departmentNm" required="N" maxLen="200" errCode="E181"/>
    <field name="positionNm" required="N" maxLen="200"/>
    <field name="employmentDt" required="N" maxLen="8" format="yyyymmdd" notFuture="Y" errCode="E316"/>
    <field name="officeTelNo" required="N" maxLen="15" pattern="^0\d{9,10}$"/>
    <field name="officeAdr" required="M" maxLen="500" fillRate="0.7"/>
    <field name="officeZipCd" required="N" maxLen="5" pattern="^\d{5}$"/>
    <field name="annualIncome" required="N" maxLen="18" genRange="60-1500"/>
    <field name="taxAmt" required="N" maxLen="18" genRange="1-100"/>
    <field name="vehicleTypeCd" required="N" maxLen="2" codeRef="C10" errCode="E304" weights="11:70,12:20,15:8,13:2" fillRate="0.7"/>
    <field name="engineDisplacementCd" required="M" maxLen="2" codeRef="C11" errCode="E300"/>
    <field name="consentFg" required="Y" maxLen="1" values="1,0" errCode="E191" weights="1:97,0:3"/>

    <rule type="atLeastOne" fields="cccdNo,cmndNo,idNumber" weights="88,8,4" errCode="E102" desc="Phải có CCCD, CMND hoặc giấy tờ khác"/>
    <rule type="requiredWhen" field="idCardType" when="idNumber" notEmpty="Y" errCode="E102"/>
    <rule type="requiredWhen" field="idNumber" when="idCardType" notEmpty="Y" errCode="E102"/>
    <rule type="atLeastOne" fields="homeAdr,officeAdr" errCode="E138" desc="Phải có địa chỉ nhà hoặc địa chỉ nơi làm việc"/>
    <rule type="dateOrder" a="birthDt" b="idIssueDt" strict="Y" gap="5840-16000" level="warn" desc="Ngày cấp giấy tờ phải sau ngày sinh (≥16 tuổi)"/>
    <rule type="dateOrder" a="birthDt" b="employmentDt" strict="Y" gap="6570-12000" level="warn" desc="Ngày vào làm phải sau ngày sinh (≥18 tuổi)"/>
    <rule type="lte" small="taxAmt" big="annualIncome" ratio="0.01-0.12" level="warn"/>
    <rule type="requiredWhen" field="engineDisplacementCd" when="vehicleTypeCd" notEmpty="Y" level="warn"/>
    <rule type="valueMap" field="engineDisplacementCd" when="vehicleTypeCd" map="11:11-13;12:14-19;13,14:17,18;15:20;*:11-20" level="warn" desc="Dung tích xi lanh phù hợp loại xe"/>
</rules>
